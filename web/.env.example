# In Vercel Services mode (vercel.json), BACKEND_URL is injected automatically
# at runtime via the service binding on `web` — do not set it manually in Vercel.
# For standalone local development without `vercel dev`, the route handler falls
# back to http://127.0.0.1:8000 automatically.
# BACKEND_URL=http://127.0.0.1:8000
